BIND_ADDR=127.0.0.1:3100
AUTOML_ENV=dev
AUTOML_API_URL=http://localhost:3100
BASE_URL=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgres://automl:automl_dev_password@127.0.0.1:55439/automl
POSTGRES_DB=automl
POSTGRES_USER=automl
POSTGRES_PASSWORD=automl_dev_password
POSTGRES_PORT=55439

MINIO_PORT=55445
MINIO_ROOT_USER=automl_minio
MINIO_ROOT_PASSWORD=automl_minio_dev_password
R2_ENDPOINT=http://127.0.0.1:55445
R2_BUCKET=automl-papers
R2_ACCESS_KEY=replace-with-local-access-key
R2_SECRET_KEY=automl_minio_dev_password
R2_PUBLIC_URL=

AUTH_SECRET=replace-with-local-dev-secret
ADMIN_KEYS=aml_replace_with_local_admin_key_or_sha256_hash
# Dual-gated with AUTOML_ENV!=production: empty ADMIN_KEYS elevates auth users only when 1
ALLOW_DEV_ADMIN=0
MAX_BODY_SIZE=52428800

# W-ID SSO. Use *_REF for vaulted production secrets.
W_ID_SSO_URL=
W_ID_CLIENT_ID=replace-with-own-client-id
W_ID_CLIENT_SECRET=replace-with-own-client-secret
# Configure your own client secret at runtime.
W_ID_REDIRECT_URI=http://localhost:3100/auth/callback
W_ID_SCOPES=openid profile email workspace
W_ID_SESSION_DAYS=7
JWT_SECRET=replace-with-local-session-secret
# Configure your own JWT signing secret at runtime.

# Radar telemetry and runtime capabilities.
SERVICE_NAME=w-automl
APP_ENV=dev
W_RADAR_CODE=
W_RADAR_ENDPOINT=
W_RADAR_URL=
W_RADAR_SLOW_TRACE_MS=1000
XRADAR_PLATFORM=w
XRADAR_RUNTIME=rust
XRADAR_CLIENT_KIND=server
# W_RADAR_API_KEY is optional for capabilities push and required only for read APIs.

# Reproduction engine (CodeOcean-style reproducible compute).
# REPRODUCE_BACKEND: "local" (subprocess on this host, dev default) or
# "cubesandbox" (Tencent CubeSandbox). Auto-selects "cubesandbox" when
# CUBE_SANDBOX_URL is set.
# REPRODUCE_BACKEND=local
REPRODUCE_TIMEOUT_SECS=900
# CUBE_SANDBOX_URL=http://127.0.0.1:8088
# CUBE_SANDBOX_API_KEY=replace-with-cubesandbox-api-key
# CUBE_REPRODUCE_CMD=python3 scripts/cube_reproduce.py
