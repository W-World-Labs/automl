# Configure only your own local instance. No hosted credentials are supplied.
DATABASE_URL=postgresql://automl:local-example-password@127.0.0.1:5432/automl
BIND_ADDR=127.0.0.1:8030
ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTOML_ENV=development
ALLOW_DEV_ADMIN=0
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./runtime/objects
STORAGE_PUBLIC_BASE=http://127.0.0.1:8030
PUBLIC_BASE_URL=http://127.0.0.1:8030
CLI_DIST_BASE=http://127.0.0.1:8030/downloads
# Register your own W-ID client and exact callback; all values stay in runtime env.
W_ID_SSO_URL=
W_ID_CLIENT_ID=
W_ID_CLIENT_SECRET=
W_ID_REDIRECT_URI=http://127.0.0.1:8030/auth/callback
JWT_SECRET=
# Optional Gitea integration: set all four together, or leave them unset.
# GITEA_URL=
# GITEA_TOKEN=
# GITEA_ORG=
# GITEA_WEBHOOK_SECRET=
